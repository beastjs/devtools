{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["vite.ts", "rspack.ts", "rsbuild.ts", "server", "shared", "client"],
  "exclude": ["**/*.test.ts"]
}
