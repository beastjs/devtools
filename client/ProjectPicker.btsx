import { useEffect, useRef, useState } from 'octane'
import { browseProject, openProject } from './api.ts'
import Icon from "../packages/icons/src/Icon.btsx";

module
  interface ProjectPickerProps {
    root: string
    external: boolean
    onSelect: (id: string) => void
  }

props { root, external, onSelect }: ProjectPickerProps
setup
  const container = useRef<HTMLDivElement | null>(null);
  const trigger = useRef<HTMLButtonElement | null>(null);
  const input = useRef<HTMLInputElement | null>(null);
  const [editing, setEditing] = useState(false);
  const [path, setPath] = useState('');
  const [busy, setBusy] = useState(false);
  const [browsing, setBrowsing] = useState(false);
  const working = busy || browsing;
  const [error, setError] = useState<string | null>(null);

  const loadProject = async (path: string) => {
    const opened = await openProject(path)
    onSelect(opened.id)
    close()
  }

  const close = () => {
    setEditing(false);
    trigger.current?.focus();
  };
  useEffect(() => {
    if (!editing) return;
    input.current?.focus();
    const dismiss = (event: PointerEvent) => {
      if (!working && event.target instanceof Node && !container.current?.contains(event.target)) setEditing(false);
    };
    const escape = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' || working) return;
      event.preventDefault();
      close();
    };
    document.addEventListener('pointerdown', dismiss);
    document.addEventListener('keydown', escape);
    return () => {
      document.removeEventListener('pointerdown', dismiss);
      document.removeEventListener('keydown', escape);
    };
  }, [editing, working]);
  const browse = async () => {
    if (working) return;
    setBrowsing(true);
    setError(null);
    try {
      const selected = await browseProject();
      if (selected.path !== null) {
        setPath(selected.path);
        await loadProject(selected.path)
      }
    } catch (cause) {
      setError(cause instanceof Error ? cause.message : String(cause));
    } finally {
      setBrowsing(false);
    }
  };
  const submit = async (event: Event) => {
    event.preventDefault();
    if (working || path.trim() === '') return;
    setBusy(true);
    setError(null);
    try {
      await loadProject(path)
    } catch (cause) {
      setError(cause instanceof Error ? cause.message : String(cause));
    } finally {
      setBusy(false);
    }
  };

div.bdt-project-picker(ref={container})
  button.bdt-icon-button(ref={trigger} type="button" disabled={working} aria-label="Open project" title={root ? `Open project · ${root}` : 'Open project'} aria-expanded={editing} aria-controls="bdt-project-popover" onClick={() => { setEditing(!editing); setError(null); }})
    Icon(name="folder" size={28} className="size-5 text-[#419cff]")
  if external
    button.bdt-button(type="button" disabled={working} onClick={() => { close(); onSelect(''); }}) Back to running app
  if editing
    div.bdt-project-popover(id="bdt-project-popover")
      form.bdt-project-form(onSubmit={submit})
        .bdt-project-form-header
          label(for="bdt-project-folder") Project folder
          if error !== null
            p.bdt-project-message(role="alert") #{error}
        .bdt-project-path-input
          input.bdt-input(ref={input} id="bdt-project-folder" type="text" value={path} placeholder="Absolute folder path on the dev server" disabled={working} onInput={(event) => setPath(event.currentTarget.value)})
        .bdt-project-actions
          .bdt-project-actions-left
            button.bdt-button(type="button" disabled={working} onClick={browse}) #{browsing ? 'Browsing…' : 'Browse'}
          .bdt-project-actions-right
            button.bdt-button(type="submit" disabled={working || path.trim() === ''}) #{busy ? 'Opening…' : 'Open'}
            button.bdt-button(type="button" disabled={working} onClick={close}) Cancel
