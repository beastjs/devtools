import { useLayoutEffect, useRef } from 'octane'
import { createCodeEditor, type CodeEditorOptions } from './code-editor.ts'

props { source, language, firstLineNumber, label, vim, disabled, onChange, onBlur, onSave, onLineClick, selectedLine = null, classesCollapsed = false, showClassControls = false, onToggleClasses, documentKey = '' }: CodeEditorOptions & { documentKey?: string; showClassControls?: boolean; onToggleClasses?: () => void }
setup
  const container = useRef<HTMLDivElement | null>(null);
  const editor = useRef<ReturnType<typeof createCodeEditor> | null>(null);
  const options = useRef<CodeEditorOptions>({ source, language, firstLineNumber, label, vim, disabled, onChange, onBlur, onSave, onLineClick, selectedLine, classesCollapsed });
  options.current = { source, language, firstLineNumber, label, vim, disabled, onChange, onBlur, onSave, onLineClick, selectedLine, classesCollapsed };
  useLayoutEffect(() => {
    if (!container.current) return;
    const instance = createCodeEditor(container.current, options.current);
    editor.current = instance;
    return () => { instance.destroy(); editor.current = null; };
  }, [documentKey, language]);
  useLayoutEffect(() => { editor.current?.update(options.current); }, [source, firstLineNumber, label, vim, disabled, onChange, onBlur, onSave, onLineClick, selectedLine, classesCollapsed]);

div.bdt-editable-code
  .bdt-code-controls
    button.bdt-button(type="button" onClick={() => editor.current?.collapseAll()} title="Collapse all code blocks") Collapse all
    button.bdt-button(type="button" onClick={() => editor.current?.expandAll()} title="Expand all code blocks") Expand all
    if showClassControls
      button.bdt-button(type="button" aria-pressed={classesCollapsed} onClick={onToggleClasses}) #{classesCollapsed ? 'Expand classes' : 'Collapse classes'}
    if onLineClick !== undefined
      span.bdt-dim(title="Click a line number, or press Alt+Enter to select the current line") Click a line number to refactor
  div.bdt-code-editor(ref={container})
