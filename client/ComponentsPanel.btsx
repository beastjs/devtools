import { useEffect, useMemo, useState, useSyncExternalStore } from 'octane'
import type { AnalyzerSettings, ComponentLocation, SourceBlockSelection } from '../shared/types.ts'
import { openInEditor } from './api.ts'
import { getRuntimeSnapshot, selectRuntimeNode, subscribeRuntime, type HookCell } from './runtime.ts'
import Splitter from './Splitter.btsx'
import SourceBlockEditor from './SourceBlockEditor.btsx'
import { findWrappers, treeRows, sourceSelections, type TreeRow, type ComponentsView } from './tree.ts'
import { cx, isExpandable, preview, pretty, valueTone } from './util.ts'
import {Icon} from "../packages/icons/src";
import { useToggle } from '../src/hooks/use-toggle.ts'


module
  interface ComponentsPanelProps {
    components: readonly ComponentLocation[]
    /** Components the app's entry module imports; the block view starts at the first one it finds. */
    entryComponents: readonly string[]
    view: ComponentsView
    onViewChange: (view: ComponentsView) => void
    showControlFlow: boolean
    onShowControlFlowChange: (value: boolean) => void
    onViewSource: (path: string, line: number) => void
    onAnalyze: (path: string) => void
    settings: AnalyzerSettings
  }

  interface ValueRow {
    key: string
    label: string
    kind: string
    value: unknown
  }

  const KIND_LABEL: Record<HookCell['kind'], string> = {
    state: 'state',
    reducer: 'reducer',
    ref: 'ref',
    'memo-or-callback': 'memo',
    other: 'hook',
  }

  /** Setup hooks whose runtime cell `inspect()` reports, keyed to the cell kind. */
  const VALUE_HOOKS: Record<string, HookCell['kind']> = {
    useState: 'state',
    useLinkedState: 'state',
    useReducer: 'reducer',
    useRef: 'ref',
    useMemo: 'memo-or-callback',
    useCallback: 'memo-or-callback',
  }

  /** Blocks indent this many levels; deeper ones show their depth instead of drifting right. */
  const BLOCK_INDENT_LIMIT = 6
  const BLOCK_INDENT = 10

  /** One stripe color per depth, cycling, so a level can be followed down the stack. */
  const DEPTH_COLORS = ['#ffb86b', '#7cb7ff', '#5fd39a', '#ff7eb6', '#c29bff', '#7fe0d0']

  const VIEWS: ReadonlyArray<{ id: ComponentsView; label: string }> = [
    { id: 'blocks', label: 'Blocks' },
    { id: 'tree', label: 'Tree' },
  ]

  /**
   * Name runtime hook cells after the setup declarations that created them.
   * Labels are applied only when the value hooks line up one-to-one by kind,
   * so a mismatch (custom hooks, conditional scopes) falls back to indices.
   */
  function hookRows(cells: readonly HookCell[], location: ComponentLocation | undefined): ValueRow[] {
    const bindings = (location?.hooks ?? []).filter((binding) => binding.hook in VALUE_HOOKS)
    const valueCells = cells.filter((cell) => cell.kind !== 'other')
    const aligned = bindings.length === valueCells.length && bindings.every((binding, index) => VALUE_HOOKS[binding.hook] === valueCells[index]!.kind)
    let next = 0
    return cells.map((cell, index) => {
      const binding = aligned && cell.kind !== 'other' ? bindings[next++] : undefined
      return {
        key: `hook-${index}`,
        label: binding?.names[0] ?? `#${index}`,
        kind: binding?.hook ?? KIND_LABEL[cell.kind],
        value: cell.value,
      }
    })
  }

props { components, entryComponents, view, onViewChange, showControlFlow, onShowControlFlowChange, onViewSource, onAnalyze, settings }: ComponentsPanelProps
setup
  const runtime = useSyncExternalStore(subscribeRuntime, getRuntimeSnapshot, getRuntimeSnapshot);
  const [query, setQuery] = useState('');
  const [collapsed, setCollapsed] = useState<ReadonlySet<number>>(new Set());
  const [expanded, setExpanded] = useState<ReadonlySet<string>>(new Set());
  const [showWrappers, setShowWrappers] = useState(false);
  const [selectedSource, setSelectedSource] = useState<SourceBlockSelection | null>(null);
  const search = query.trim().toLowerCase();
  // Blocks start at the app's entry component; a search always covers everything.
  const wrappers = useMemo(() => findWrappers(runtime.roots, entryComponents, showControlFlow), [runtime.roots, entryComponents, showControlFlow]);
  const hideWrappers = view === 'blocks' && wrappers !== null && !showWrappers && search === '';
  const rows = useMemo(
    () => treeRows(hideWrappers ? wrappers!.tops : runtime.roots, collapsed, showControlFlow, search, new Set(view === 'blocks' ? (wrappers?.chain.map((node) => node.id) ?? []) : []), view === 'blocks'),
    [runtime.roots, wrappers, hideWrappers, view, collapsed, showControlFlow, search],
  );
  const sources = useMemo(() => sourceSelections(runtime.roots, components), [runtime.roots, components]);
  useEffect(() => {
    if (runtime.selectedId === null) return;
    const source = sources.get(runtime.selectedId)?.selection;
    if (source) setSelectedSource((current) => current?.path === source.path && current.host === source.host && current.line === source.line && current.kind === source.kind ? current : source);
  }, [sources, runtime.selectedId]);
  const rowSelected = (row: TreeRow) => {
    if (runtime.selectedId !== null) return row.memberIds.includes(runtime.selectedId);
    const source = sources.get(row.node.id)?.selection;
    return selectedSource !== null && source !== undefined && source.path === selectedSource.path && source.host === selectedSource.host && source.line === selectedSource.line && source.kind === selectedSource.kind;
  };
  const selectRow = (row: TreeRow) => {
    selectRuntimeNode(row.node.id);
    setSelectedSource(sources.get(row.node.id)?.selection ?? null);
  };
  const detail = runtime.detail;
  const selectedBlock = detail === null ? undefined : sources.get(detail.id)?.block;
  const location = selectedSource === null ? (detail === null ? undefined : components.find((component) => component.name === detail.name)) : components.find((component) => component.name === selectedSource.host && component.path === selectedSource.path);
  const hooks = detail === null ? [] : hookRows(detail.hooks, location);
  const context = detail === null ? [] : detail.context.map((entry, index) => ({ key: `context-${index}`, label: entry.name, kind: 'context', value: entry.value }));
  const values = [...hooks, ...context];
  const toggleNode = (id: number) => setCollapsed((current) => {
    const next = new Set(current);
    if (next.has(id)) next.delete(id);
    else next.add(id);
    return next;
  });
  const toggleValue = (key: string) => setExpanded((current) => {
    const next = new Set(current);
    if (next.has(key)) next.delete(key);
    else next.add(key);
    return next;
  });

  const [isSearchExpanded, toggleSearch] = useToggle();
  const handleToggleSearch = (e: MouseEvent | FocusEvent) => {
    e.preventDefault();
    void toggleSearch();
  };

if runtime.status === 'unavailable'
  .bdt-empty
    .bdt-empty-card
      p.bdt-empty-title Runtime inspection is off
      p Octane exposes its component tree only when profiling metadata is compiled in. Enable it for dev builds:
      pre.bdt-pre #{"// vite.config.ts\nbeastOctane({ octane: { profile: 'auto' } })\n\n// rspack.config.ts, rsbuild.config.ts\nbeastOctane({ octane: { profile: process.env.NODE_ENV !== 'production' } })"}
      p.bdt-dim BTSX → TSRX and Refactor keep working without it.
elseif runtime.status === 'connecting'
  .bdt-empty
    p Connecting to the Octane runtime…
else
  fragment
    .bdt-pane
      .bdt-toolbar
        .bdt-segment(role="group" aria-label="Tree style")
          each option in VIEWS key option.id
            button(
              ~ type="button"
              ~ aria-pressed={view === option.id}
              ~ className={cx('bdt-segment-item', view === option.id && 'is-active')}
              ~ onClick={() => onViewChange(option.id)}
              ~ )
              | #{option.label}

        if isSearchExpanded
          input.bdt-input(
            ~ type="search"
            ~ placeholder="Filter components"
            ~ aria-label="Filter components"
            ~ onBlur={handleToggleSearch}
            ~ value={query}
            ~ onInput={(event) => setQuery(event.currentTarget.value)}
            ~ className={' w-full!'}
            ~ )
        else
          div(className='flex justify-between items-center w-full! border gap-12')
            label.bdt-check  Control flow
              input(type="checkbox" checked={showControlFlow} onChange={(event) => onShowControlFlowChange(event.currentTarget.checked)})
            button(onClick={handleToggleSearch})
              Icon(name="search" size={12} className='text-[var(--bdt-dim-2)] place-self-end')
        .bdt-spacer
      .bdt-scroll
        if rows.length === 0
          p.bdt-empty #{query === '' ? 'No Octane roots are mounted.' : 'Nothing matches that filter.'}
        elseif view === 'blocks'
          div.bdt-blocks(role="tree" aria-label="Component blocks")
            if wrappers !== null && search === ''
              button(
                ~ type="button"
                ~ aria-expanded={showWrappers}
                ~ className={cx('bdt-wrappers', showWrappers && 'is-open')}
                ~ title={showWrappers ? 'Fold the wrappers above the app back up' : 'Show the providers the app is wrapped in'}
                ~ onClick={() => setShowWrappers((value) => !value)}
                ~ )
                span.bdt-wrappers-count #{wrappers.chain.length}
                span.bdt-wrappers-label wrapper#{wrappers.chain.length === 1 ? '' : 's'} #{showWrappers ? 'shown' : 'hidden'}
                span.bdt-wrappers-chain #{wrappers.chain.map((node) => node.label).join(' › ')}
                span.bdt-wrappers-action #{showWrappers ? 'hide' : 'show'}
            each row in rows key row.node.id
              button(
                ~ type="button"
                ~ role="treeitem"
                ~ aria-level={row.depth + 1}
                ~ aria-selected={rowSelected(row)}
                ~ aria-expanded={row.expandable ? row.open : undefined}
                ~ className={cx('bdt-block', row.depth % 2 === 1 && 'is-odd', rowSelected(row) && 'is-selected', row.wrapper && 'is-wrapper')}
                ~ style={{ marginLeft: `${Math.min(row.depth, BLOCK_INDENT_LIMIT) * BLOCK_INDENT}px`, borderLeftColor: DEPTH_COLORS[row.depth % DEPTH_COLORS.length] }}
                ~ onClick={() => selectRow(row)}
                ~ onDoubleClick={() => row.expandable && toggleNode(row.node.id)}
                ~ )
                span(
                  ~ className={cx('bdt-caret', row.open && 'is-open')}
                  ~ onClick={(event) => { event.stopPropagation(); if (row.expandable) toggleNode(row.node.id); }}
                  ~ )
                  | #{row.expandable ? '▸' : ''}
                span(className={cx('bdt-block-name', row.node.controlFlow && 'is-flow')}) #{row.node.label}
                if row.node.kind === 'root' || row.node.kind === 'portal'
                  span.bdt-badge #{row.node.kind}
                if row.depth > BLOCK_INDENT_LIMIT
                  span.bdt-block-depth(title={`Nested ${row.depth} levels deep`}) L#{row.depth}
                span.bdt-spacer
                if row.mappedCount !== null
                  span.bdt-block-map(title={`${sources.get(row.node.id)?.block.iterable ?? 'Mapped items'} · ${sources.get(row.node.id)?.block.itemType ?? 'unknown'}`}) #{row.mappedCount} item#{row.mappedCount === 1 ? '' : 's'} · #{sources.get(row.node.id)?.block.itemType ?? 'unknown'}
                if row.expandable && !row.open
                  span.bdt-block-count(title={`${row.childCount} hidden child${row.childCount === 1 ? '' : 'ren'}`}) +#{row.childCount}
                span.bdt-tree-id ##{row.node.id}
        else
          div.bdt-tree(role="tree" aria-label="Component tree")
            each row in rows key row.node.id
              button(
                ~ type="button"
                ~ role="treeitem"
                ~ aria-selected={rowSelected(row)}
                ~ aria-expanded={row.expandable ? row.open : undefined}
                ~ className={cx('bdt-tree-row', rowSelected(row) && 'is-selected')}
                ~ style={{ paddingLeft: `${6 + row.depth * 14}px` }}
                ~ onClick={() => selectRow(row)}
                ~ onDoubleClick={() => row.expandable && toggleNode(row.node.id)}
                ~ )
                span(
                  ~ className={cx('bdt-caret', row.open && 'is-open')}
                  ~ onClick={(event) => { event.stopPropagation(); if (row.expandable) toggleNode(row.node.id); }}
                  ~ )
                  | #{row.expandable ? '▸' : ''}
                span(className={cx('bdt-tree-name', row.node.controlFlow && 'is-flow')}) #{row.node.label}
                if row.node.kind === 'root' || row.node.kind === 'portal'
                  span.bdt-badge(style={{ marginLeft: '8px' }}) #{row.node.kind}
                span.bdt-tree-id ##{row.node.id}
    aside.bdt-detail(aria-label="Selected component")
      Splitter(split="detail" edge="start" label="Resize component details")
      if detail !== null
        .bdt-detail-head
          p.bdt-detail-name
            | #{selectedBlock?.kind === 'each' ? `each ${selectedBlock.itemName} in ${selectedBlock.iterable}` : selectedBlock?.host ?? detail.name}
            span.bdt-badge ##{detail.id}
          if location === undefined
            p.bdt-dim No .btsx declaration found for this name.
          else
            fragment
              button.bdt-link(type="button" title="Open in editor" onClick={() => openInEditor(location.absolutePath, location.line, location.column)}) #{location.path}:#{location.line}
              .bdt-detail-actions
                button.bdt-button(type="button" onClick={() => onViewSource(location.path, location.line)}) BTSX → TSRX
                button.bdt-button(type="button" onClick={() => onAnalyze(location.path)}) Analyze file
                button.bdt-button(type="button" onClick={() => openInEditor(location.absolutePath, location.line, location.column)}) Open in editor
      SourceBlockEditor(selection={selectedSource} settings={settings} onSelectionChange={setSelectedSource} selectionMessage={detail === null ? undefined : `No editable BTSX source was found for ${detail.name}.`})
      if detail !== null
        details.bdt-runtime-details
          summary State, context & effects
          .bdt-runtime-values
            p.bdt-section-label State & hooks
            if values.length === 0
              p.bdt-dim(style={{ padding: '0 14px' }}) No hook state or context.
            else
              .bdt-props
                each item in values key item.key
                  div.bdt-prop
                    span.bdt-prop-key
                      | #{item.label}
                      span.bdt-prop-kind #{item.kind}
                    if isExpandable(item.value)
                      span(
                        ~ role="button"
                        ~ tabIndex={0}
                        ~ aria-expanded={expanded.has(item.key)}
                        ~ className={cx('bdt-prop-value', 'is-toggle', valueTone(item.value))}
                        ~ onClick={() => toggleValue(item.key)}
                        ~ onKeyDown={(event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleValue(item.key); } }}
                        ~ )
                        | #{expanded.has(item.key) ? '▾ ' : '▸ '}#{preview(item.value)}
                    else
                      span(className={cx('bdt-prop-value', valueTone(item.value))}) #{preview(item.value)}
                    if expanded.has(item.key)
                      pre.bdt-pre #{pretty(item.value)}
            p.bdt-section-label Effects
            p.bdt-dim(style={{ padding: '0 14px 14px' }}) #{detail.effectCount} effect slot#{detail.effectCount === 1 ? '' : 's'}
