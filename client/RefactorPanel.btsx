import { useEffect, useRef, useState } from 'octane'
import type { AnalyzerSettings, ApplyResult, DiffLine, FileReport, FileSummary, RefactorSuggestion, RefactorTarget } from '../shared/types.ts'
import CodeView from './CodeView.btsx'
import FileList from './FileList.btsx'
import { applyRefactor, copyText, fetchSelection, openInEditor, undoRefactor } from './api.ts'
import PathLabel from './PathLabel.btsx'
import Splitter from './Splitter.btsx'
import CallChip from '../components/call-chip.btsx'
import { cx, scrollTarget, type RecentRefactor, type ScrollTarget } from './util.ts'
import { nameIssue } from './refactor-actions.ts'

module
  interface RefactorPanelProps {
    projectId: string
    files: readonly FileSummary[]
    file: string | null
    report: FileReport | null
    loadError: string | null
    settings: AnalyzerSettings
    recent: RecentRefactor | null
    onSelectFile: (path: string) => void
    onSettingsChange: (settings: AnalyzerSettings) => void
    onRecentChange: (recent: RecentRefactor | null) => void
  }

  /** A refactor being reviewed: previewed as a dry run, then confirmed. */
  interface PendingRefactor {
    suggestionId: string
    target: RefactorTarget
    status: 'loading' | 'ready' | 'applying'
    result: ApplyResult | null
    error: string | null
    name: string
  }

  function targetLabel(target: RefactorTarget, suggestion: RefactorSuggestion): string {
    if (suggestion.kind === 'empty-style') return 'Remove empty style'
    if (suggestion.kind === 'continuation') return 'Continue props with ~'
    if (suggestion.mapping !== null) return 'map ⧉'
    return target === 'file' ? `create ⯌` : ` hoist ✦`


  }

  function targets(suggestion: RefactorSuggestion): RefactorTarget[] {
    if (suggestion.autoApply.blocked !== null) return []
    if (suggestion.kind === 'continuation' || suggestion.kind === 'empty-style' || suggestion.mapping !== null) return ['inline']
    const other: RefactorTarget = suggestion.autoApply.target === 'file' ? 'inline' : 'file'
    const allowed = other === 'file' ? suggestion.autoApply.fileBlocked === null : true
    return allowed ? [suggestion.autoApply.target, other] : [suggestion.autoApply.target]
  }

  const DIFF_SIGN: Record<DiffLine['type'], string> = { add: '+', remove: '-', context: ' ' }

  function message(error: unknown): string {
    return error instanceof Error ? error.message : String(error)
  }

  function tone(depth: number, limit: number): string {
    return depth > limit ? 'is-over' : depth === limit ? 'is-near' : ''
  }

  function kindLabel(suggestion: RefactorSuggestion): string {
    if (suggestion.kind === 'empty-style') return 'cleanup'
    if (suggestion.kind === 'continuation') return 'continuation'
    if (suggestion.mapping !== null) return `${suggestion.mapping.items.length}× repeated`
    if (suggestion.id.startsWith('manual:')) return 'manual'
    return suggestion.kind === 'extract' ? '✦' : `${suggestion.occurrences.length}× same shape`
  }

  function applyGuide(suggestion: RefactorSuggestion): string {
    if (suggestion.kind === 'continuation' || suggestion.kind === 'empty-style') return suggestion.usage
    const where = suggestion.occurrences.map((range) => `${range.startLine}–${range.endLine}`).join(', ')
    return [
      `// 1. Add above line ${suggestion.insertBeforeLine}:`,
      suggestion.snippet,
      '',
      `// 2. Replace line${suggestion.occurrences.length === 1 ? 's' : ' ranges'} ${where} with:`,
      suggestion.usage.trimStart(),
    ].join('\n')
  }

  function readLimit(value: string, min: number, max: number): number | null {
    const parsed = Number.parseInt(value, 10)
    return Number.isInteger(parsed) && parsed >= min && parsed <= max ? parsed : null
  }

props { projectId, files, file, report, loadError, settings, recent, onSelectFile, onSettingsChange, onRecentChange }: RefactorPanelProps
setup
  const [names, setNames] = useState<Record<string, string>>({});
  const nameOf = (suggestion: RefactorSuggestion) => names[suggestion.id] ?? suggestion.name;
  const rename = (suggestion: RefactorSuggestion, name: string) => {
    setNames((value) => ({ ...value, [suggestion.id]: name }));
    // A preview was made for the old name.
    setPending((value) => (value?.suggestionId === suggestion.id && value.status !== 'applying' ? null : value));
  };
  const [pending, setPending] = useState<PendingRefactor | null>(null);
  const [refactorCall, setRefactorCall] = useState<{ status: 'running' | 'done' | 'error'; name: string } | null>(null);
  useEffect(() => {
    if (refactorCall?.status !== 'done') return;
    const timer = setTimeout(() => setRefactorCall(null), 3000);
    return () => clearTimeout(timer);
  }, [refactorCall]);
  const [undoError, setUndoError] = useState<string | null>(null);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [openId, setOpenId] = useState<string | null>(null);
  const [copied, setCopied] = useState<string | null>(null);
  const [scroll, setScroll] = useState<ScrollTarget | null>(null);
  const current = report !== null && report.path === file ? report : null;
  const analysis = current?.analysis ?? null;
  const [manual, setManual] = useState<{ hash: string; path: string; suggestions: RefactorSuggestion[] } | null>(null);
  const [selectionError, setSelectionError] = useState<string | null>(null);
  const [selecting, setSelecting] = useState(false);
  const selectionRequest = useRef(0);
  const suggestionsPane = useRef<HTMLElement | null>(null);
  let copyTimer: ReturnType<typeof setTimeout>;
  useEffect(() => () => clearTimeout(copyTimer), []);
  const manualSuggestions = manual?.hash === current?.hash && manual?.path === file ? manual?.suggestions : undefined;
  const suggestions = [...(manualSuggestions ?? []), ...(analysis?.suggestions ?? []).filter((suggestion) =>
    !manualSuggestions?.some((manual) => manual.kind === suggestion.kind && manual.startLine === suggestion.startLine && manual.endLine === suggestion.endLine)
  )];
  const selected = suggestions.find((suggestion) => suggestion.id === selectedId) ?? null;
  useEffect(() => {
    if (manualSuggestions && suggestionsPane.current) suggestionsPane.current.scrollTop = 0;
  }, [manualSuggestions]);
  const histogramMax = Math.max(1, ...(analysis?.histogram ?? [1]));
  const select = (suggestion: RefactorSuggestion) => {
    setSelectedId(suggestion.id);
    setScroll(scrollTarget(suggestion.startLine));
  };
  const selectBlock = async (line: number) => {
    if (current === null || pending?.status === 'applying') return;
    if (selected?.startLine === line) {
      selectionRequest.current += 1;
      setSelecting(false);
      setSelectedId(null);
      setPending(null);
      setSelectionError(null);
      return;
    }
    const cleanup = suggestions.find((suggestion) => suggestion.kind === 'empty-style' && suggestion.startLine === line);
    const continuation = cleanup ?? suggestions.find((suggestion) => suggestion.kind === 'continuation' && suggestion.startLine === line);
    if (continuation) {
      selectionRequest.current += 1;
      setSelecting(false);
      select(continuation);
      setSelectionError(null);
      return;
    }
    const request = ++selectionRequest.current;
    setSelecting(true);
    setSelectionError(null);
    setManual(null);
    setSelectedId(null);
    setPending(null);
    try {
      const selection = await fetchSelection(current.path, line, settings, projectId);
      if (request !== selectionRequest.current) return;
      if (selection.hash !== current.hash) throw new Error('The file changed. Wait for it to refresh and select the block again.');
      const suggestion = selection.analysis?.suggestions[0];
      if (suggestion && suggestion.id !== `manual:${line}`) throw new Error('Restart the dev server to enable manual extraction, then select the block again.');
      if (!suggestion) throw new Error('Click the first line of an HTML element or a complete control-flow block. Imports, setup, continuation lines and existing component calls cannot be extracted.');
      setManual({ hash: selection.hash, path: selection.path, suggestions: selection.analysis!.suggestions });
      setNames((value) => ({ ...value, [suggestion.id]: suggestion.name }));
      setSelectedId(suggestion.id);
      setOpenId(null);
    } catch (error) {
      if (request === selectionRequest.current) setSelectionError(message(error));
    } finally {
      if (request === selectionRequest.current) setSelecting(false);
    }
  };
  useEffect(() => {
    setManual(null);
    setSelectionError(null);
    setSelecting(false);
    return () => { selectionRequest.current += 1; };
  }, [file, current?.hash, projectId, settings]);
  const copy = async (key: string, text: string) => {
    if (!(await copyText(text))) return;
    setCopied(key);
    copyTimer = setTimeout(() => setCopied((value) => (value === key ? null : value)), 1400);
    clearTimeout(copyTimer);
  };
  useEffect(() => {
    setSelectedId(null);
    setOpenId(null);
    setPending(null);
  }, [file]);
  // A preview describes one version of the file; drop it once the file changes.
  useEffect(() => {
    setPending((value) => (value?.status === 'applying' ? value : null));
    setNames({});
  }, [current?.hash]);

  const preview = async (suggestion: RefactorSuggestion, target: RefactorTarget) => {
    if (current === null) return;
    const name = nameOf(suggestion).trim();
    const request = { path: current.path, hash: current.hash, settings, suggestionId: suggestion.id, target, name };
    setPending({ suggestionId: suggestion.id, target, status: 'loading', result: null, error: null, name });
    const same = (value: PendingRefactor | null) => value?.suggestionId === suggestion.id && value.target === target;
    try {
      const result = await applyRefactor({ ...request, dryRun: true }, projectId);
      setPending((value) => (same(value) ? { ...value!, status: 'ready', result } : value));
    } catch (error) {
      setPending((value) => (same(value) ? { ...value!, status: 'ready', error: message(error) } : value));
    }
  };
  const confirm = async () => {
    if (pending === null || current === null) return;
    const request = { path: current.path, hash: current.hash, settings, suggestionId: pending.suggestionId, target: pending.target, name: pending.name };
    setPending({ ...pending, status: 'applying' });
    setRefactorCall({ status: 'running', name: pending.name });
    try {
      const result = await applyRefactor({ ...request, dryRun: false }, projectId);
      setPending(null);
      setSelectedId(null);
      setOpenId(null);
      setUndoError(null);
      onRecentChange({ undoId: result.undoId!, summary: result.summary });
      setRefactorCall({ status: 'done', name: pending.name });
    } catch (error) {
      setRefactorCall({ status: 'error', name: pending.name });
      setPending({ ...pending, status: 'ready', error: message(error) });
    }
  };
  const undo = async () => {
    if (recent === null) return;
    try {
      await undoRefactor(recent.undoId, projectId);
      setUndoError(null);
      onRecentChange(null);
    } catch (error) {
      setUndoError(message(error));
    }
  };

.bdt-pane
  if refactorCall !== null
    .bdt-refactor-call
      CallChip(icon="edit" name="Refactor" argument={refactorCall.name} status={refactorCall.status} color="var(--bdt-text)" surfaceColor="var(--bdt-bg-4)" doneColor="var(--bdt-ok)" errorColor="var(--bdt-bad)" onRetry={refactorCall.status === 'error' ? confirm : undefined})
  .bdt-toolbar
    span.bdt-toolbar-title.bdt-mono
      PathLabel(path={file ?? 'No file selected'})
    .bdt-spacer
    label.bdt-field(title="Template nesting depth above which lines count as too deep")
      | Depth limit
      input.bdt-input.is-number(
        ~ type="number"
        ~ min="1"
        ~ max="20"
        ~ value={settings.depthLimit}
        ~ onInput={(event) => { const depthLimit = readLimit(event.currentTarget.value, 1, 20); if (depthLimit !== null) onSettingsChange({ ...settings, depthLimit }); }}
        ~ )
    label.bdt-field(title="Smallest section, in lines, worth extracting")
      | Min lines
      input.bdt-input.is-number(
        ~ type="number"
        ~ min="2"
        ~ max="200"
        ~ value={settings.minLines}
        ~ onInput={(event) => { const minLines = readLimit(event.currentTarget.value, 2, 200); if (minLines !== null) onSettingsChange({ ...settings, minLines }); }}
        ~ )
    label.bdt-field(title="Sections with at least this many lines move to their own .btsx file by default")
      | New file at
      input.bdt-input.is-number(
        ~ type="number"
        ~ min="2"
        ~ max="1000"
        ~ value={settings.fileLines}
        ~ onInput={(event) => { const fileLines = readLimit(event.currentTarget.value, 2, 1000); if (fileLines !== null) onSettingsChange({ ...settings, fileLines }); }}
        ~ )
    label.bdt-field(title="Minimum inline props for an automatic continuation suggestion")
      | Continue at props
      input.bdt-input.is-number(
        ~ type="number"
        ~ min="1"
        ~ max="1000"
        ~ value={settings.continuationMinProps}
        ~ onInput={(event) => { const continuationMinProps = readLimit(event.currentTarget.value, 1, 1000); if (continuationMinProps !== null) onSettingsChange({ ...settings, continuationMinProps }); }}
        ~ )
  if recent !== null
    div(className={cx('bdt-toast', undoError !== null && 'is-error')} role="status")
      span #{undoError ?? `✓ ${recent.summary}`}
      .bdt-spacer
      if undoError === null
        button.bdt-button(type="button" onClick={undo}) Undo
      button.bdt-icon-button(type="button" aria-label="Dismiss" onClick={() => { setUndoError(null); onRecentChange(null); }}) ×
  if current === null || analysis === null
    .bdt-refactor-fallback
      FileList(files={files} active={file} metrics={true} onSelect={onSelectFile})
      if loadError !== null && current === null
        .bdt-empty
          p Could not analyze #{file ?? 'the file'}: #{loadError}
      elseif current === null
        .bdt-empty
          p #{files.length === 0 ? 'No .btsx files found under the configured include directories.' : 'Analyzing…'}
      elseif analysis === null
        .bdt-empty
          .bdt-empty-card
            p.bdt-empty-title This file does not compile
            p Fix the error shown in BTSX → TSRX to analyze its structure.
  else
    .bdt-refactor
      .bdt-refactor-overview
        .bdt-metrics
          .bdt-metric(className={analysis.maxDepth > settings.depthLimit && 'metric-alert'})
            span(className={cx('bdt-metric-value', analysis.maxDepth > settings.depthLimit && 'is-over')}) #{analysis.maxDepth}
            span.bdt-metric-label Max depth
          .bdt-metric
            span.bdt-metric-value #{analysis.averageDepth}
            span.bdt-metric-label Avg depth
          .bdt-metric(className={analysis.deepLines > 0 && 'metric-alert'})
            span(className={cx('bdt-metric-value', analysis.deepLines > 0 && 'is-over')}) #{analysis.deepLines}
            span.bdt-metric-label Lines over #{settings.depthLimit}
          .bdt-metric
            span.bdt-metric-value #{analysis.templateLines}
            span.bdt-metric-label Template lines
          .bdt-metric
            span.bdt-metric-value #{analysis.indentUnit}
            span.bdt-metric-label Indent spaces
          div.bdt-histogram(role="img" aria-label={`Template lines per depth: ${analysis.histogram.map((count, depth) => `depth ${depth}: ${count}`).join(', ')}`})
            each count, depth in analysis.histogram key depth
              .bdt-histogram-col(title={`Depth ${depth}: ${count} line${count === 1 ? '' : 's'}`})
                span(className={cx('bdt-histogram-bar', tone(depth, settings.depthLimit))} style={{ height: `${Math.max(2, Math.round((count / histogramMax) * 24))}px` }})
                span.bdt-histogram-label #{depth}
        .bdt-refactor-left-body
          FileList(files={files} active={file} metrics={true} onSelect={onSelectFile})
          section.bdt-suggestions(ref={suggestionsPane} aria-label="Refactor suggestions")
            if suggestions.length === 0
              .bdt-empty
                .bdt-empty-card
                  p.bdt-empty-title No automatic suggestions
                  p Click a starting line in the source to extract a block manually.
            else
              each suggestion in suggestions key suggestion.id
                article(
                  ~ className={cx('bdt-card', suggestion.id === selectedId && 'is-selected')}
                  ~ onClick={() => select(suggestion)}
                  ~ )
                  .bdt-card-head
                    span(className={cx('bdt-severity', `is-${suggestion.severity}`)} title={suggestion.severity})
                    if suggestion.kind !== 'continuation' && suggestion.kind !== 'empty-style' && targets(suggestion).length > 0
                      input(
                        ~ className={cx('bdt-card-title', 'bdt-card-title-input', nameIssue(suggestion, nameOf(suggestion)) !== null && 'is-invalid')}
                        ~ value={nameOf(suggestion)}
                        ~ aria-label={suggestion.mapping === null ? 'Component name' : suggestion.mapping.placement === 'module' ? 'Array name' : 'Loop item name'}
                        ~ title={nameIssue(suggestion, nameOf(suggestion)) ?? 'Rename before applying'}
                        ~ spellcheck="false"
                        ~ autocomplete="off"
                        ~ onClick={(event) => event.stopPropagation()}
                        ~ onInput={(event) => rename(suggestion, event.currentTarget.value)}
                        ~ )
                    else
                      span.bdt-card-title #{suggestion.name}
                    span(className={cx('bdt-badge', suggestion.kind === 'extract' ? 'is-warn' : 'is-info')}) #{kindLabel(suggestion)}
                    span.bdt-dim.bdt-metric-label L#{suggestion.startLine}–#{suggestion.endLine}
                  p.bdt-card-reason #{suggestion.reason}
                  .bdt-card-meta
                    span.bdt-chip #{suggestion.label} in #{suggestion.host}
                    if !suggestion.typesDerived && suggestion.props.length > 0
                      span.bdt-chip(title="TypeScript could not be loaded from this project, so prop types are estimated") estimated types
                    each prop in suggestion.props key prop.name
                      span.bdt-chip(title={`${prop.name}: ${prop.type}`})
                        | #{prop.name}
                        span.bdt-chip-type #{': ' + prop.type}
                  .bdt-card-actions
                    button.bdt-button(type="button" aria-expanded={openId === suggestion.id} onClick={() => setOpenId(openId === suggestion.id ? null : suggestion.id)}) #{openId === suggestion.id ? '🞁' : '🞃'}
                    if suggestion.kind !== 'continuation' && suggestion.kind !== 'empty-style'
                      button.bdt-button(type="button" onClick={() => copy(`${suggestion.id}:component`, suggestion.snippet)}) #{copied === `${suggestion.id}:component` ? 'component ⮻' : 'component ⮺'}
                    button.bdt-button(type="button" onClick={() => copy(`${suggestion.id}:usage`, suggestion.usage.trimStart())}) #{copied === `${suggestion.id}:usage` ? 'usage ⮻' : 'usage ⮺'}
                    button.bdt-button(type="button" onClick={() => openInEditor(current.absolutePath, suggestion.startLine)}) open ⧽
                  .bdt-card-actions
                    each target, index in targets(suggestion) key target
                      button(
                        ~ type="button"
                        ~ className={cx('bdt-button-critical', index === 0 && '')}
                        ~ title={suggestion.kind === 'empty-style' ? 'Remove the empty style attribute from this element' : suggestion.kind === 'continuation' ? 'Move each prop onto its own ~ continuation line' : suggestion.mapping !== null ? 'Render the repeated elements from an array with each' : target === 'file' ? `Write ${nameOf(suggestion).trim()}.btsx next to this file and import it` : 'Add a local component to this file'}
                        ~ disabled={pending?.status === 'applying' || pending?.status === 'loading' || nameIssue(suggestion, nameOf(suggestion)) !== null}
                        ~ onClick={() => preview(suggestion, target)}
                        ~ )
                        | #{targetLabel(target, suggestion)}

                  if suggestion.autoApply.blocked !== null
                    p.bdt-card-note Manual only: #{suggestion.autoApply.blocked}
                  elseif suggestion.autoApply.fileBlocked !== null && suggestion.mapping === null
                    p.bdt-card-note Stays in this file: #{suggestion.autoApply.fileBlocked}
                  if pending !== null && pending.suggestionId === suggestion.id
                    div.bdt-plan(role="group" aria-label="Review refactor")
                      if pending.status === 'loading'
                        p.bdt-muted Preparing #{targetLabel(pending.target, suggestion).toLowerCase()}…
                      else
                        fragment
                          if pending.result !== null
                            fragment
                              p.bdt-plan-title Review · #{targetLabel(pending.target, suggestion)} · #{pending.result.files.length} file#{pending.result.files.length === 1 ? '' : 's'}
                              each change in pending.result.files key change.path
                                .bdt-plan-file
                                  .bdt-plan-file-head
                                    span
                                      PathLabel(path={change.path})
                                    span(className={cx('bdt-badge', change.action === 'create' ? 'is-ok' : 'is-info')}) #{change.action === 'create' ? 'new file' : 'edit'}
                                    span.bdt-added +#{change.added}
                                    span.bdt-removed −#{change.removed}
                                  .bdt-diff
                                    .bdt-diff-inner
                                      each hunk, hunkIndex in change.hunks key hunkIndex
                                        fragment
                                          p.bdt-diff-head @@ −#{hunk.oldStart} +#{hunk.newStart} @@
                                          each line, lineIndex in hunk.lines key lineIndex
                                            div(className={`bdt-diff-line is-${line.type}`}) #{DIFF_SIGN[line.type] + ' ' + line.text}
                          if pending.error !== null
                            pre.bdt-plan-error #{pending.error}
                          .bdt-card-actions
                            if pending.result !== null && pending.error === null
                              button.bdt-button-critical(type="button" disabled={pending.status === 'applying'} onClick={confirm}) #{pending.status === 'applying' ? 'Applying…' : 'Apply changes'}
                            button.bdt-button(type="button" disabled={pending.status === 'applying'} onClick={() => setPending(null)}) Cancel
                  if openId === suggestion.id
                    pre.bdt-pre #{applyGuide(suggestion)}
      section.bdt-pane(aria-label="Source with nesting depth")
        Splitter(split="refactor" edge="start" label="Resize suggestions and source")
        .bdt-pane-head
          span Nesting depth per line
          .bdt-spacer
          span.bdt-dim #{selecting ? 'Selecting block…' : selected === null ? 'Click code to select; line numbers fold blocks' : `${selected.name} highlighted · click again to deselect`}
        if selectionError !== null
          p.bdt-project-message(role="status") #{selectionError}
        CodeView(
          ~ classControls={true}
          ~ source={current.source}
          ~ language="btsx"
          ~ label="BTSX source with nesting depth"
          ~ depths={analysis.lineDepths}
          ~ depthLimit={settings.depthLimit}
          ~ ranges={selected?.occurrences}
          ~ activeLine={selected?.startLine}
          ~ onLineClick={selectBlock}
          ~ scrollTo={scroll}
          ~ )
