import { useEffect, useRef, useState, useSyncExternalStore } from 'octane'
import type { AnalyzerSettings, ComponentLocation, FileReport, FileSummary, ProjectReport } from '../shared/types.ts'
import { BeastLogo, ComponentFinderIcon, ElementPickerIcon } from './Icons.btsx'
import ComponentsPanel from './ComponentsPanel.btsx'
import ElementsPanel from './ElementsPanel.btsx'
import { startLayoutEditor } from './element-layout.ts'
import { ElementInspection } from './element-inspector.ts'
import InspectorPanel from './InspectorPanel.btsx'
import RefactorPanel from './RefactorPanel.btsx'
import Topbar from './Topbar.btsx'
import { fetchFile, fetchProject, onSourceChanged, openInEditor } from './api.ts'
import { startComponentFinder, startElementPicker, type ElementTool } from './element-tools.ts'
import { getRuntimeSnapshot, subscribeRuntime } from './runtime.ts'
import { clampHeight, cx, loadPreferences, savePreferences, scrollTarget, startResize, TABS, type RecentRefactor, type ScrollTarget, type TabId } from './util.ts'

module
  const initial = loadPreferences()

  /** Alt+Shift+D toggles the panel. `code` is used because Alt changes `key` on macOS. */
  function isToggleShortcut(event: KeyboardEvent): boolean {
    return event.altKey && event.shiftKey && !event.metaKey && !event.ctrlKey && event.code === 'KeyD'
  }

  /** Alt+Shift+C toggles Component Finder. */
  function isComponentFinderShortcut(event: KeyboardEvent): boolean {
    return event.altKey && event.shiftKey && !event.metaKey && !event.ctrlKey && event.code === 'KeyC'
  }

  /** Alt+Shift+E toggles Element Picker. */
  function isElementPickerShortcut(event: KeyboardEvent): boolean {
    return event.altKey && event.shiftKey && !event.metaKey && !event.ctrlKey && event.code === 'KeyE'
  }

  /**
   * Shared empty props. `?? []` inline would mint a fresh array identity on
   * every render and defeat the memoized tree/file derivations downstream.
   */
  const EMPTY_COMPONENTS: readonly ComponentLocation[] = []
  const EMPTY_STRINGS: readonly string[] = []
  const EMPTY_FILES: readonly FileSummary[] = []

  /** Settings inputs emit per keystroke; server fetches wait for a pause. */
  const SETTINGS_DEBOUNCE_MS = 300

module
  interface DevtoolsInterfaceProps {
    theme: 'dark' | 'light'
    open: boolean
    componentFinderActive: boolean
    componentFinderTitle: 'Stop Component Finder (Esc)' | 'Component Finder (Alt+Shift+C)'
    setActiveElementTool: (next: ElementTool | ((prev: ElementTool | null) => ElementTool | null) | null) => void
    elementPickerActive: boolean
    elementPickerTitle: 'Stop Element Picker (Esc)' | 'Element Picker (Alt+Shift+E)'
    setOpen: (next: boolean | ((prev: boolean) => boolean)) => void
  }

component DevtoolsInterface
  props { theme, open, componentFinderActive, componentFinderTitle, setActiveElementTool, elementPickerActive, elementPickerTitle, setOpen }: DevtoolsInterfaceProps
  div(data-theme={theme} className={cx('bdt-root', 'bdt-launcher-host', open && 'is-hidden')} aria-hidden={open ? 'true' : undefined})
    button(type="button" className={cx('bdt-launcher-component-finder bg-white/50 backdrop-blur-3xl', componentFinderActive && 'is-component-finder-active')} aria-pressed={componentFinderActive} aria-label="Component Finder" title={componentFinderTitle} onClick={() => setActiveElementTool((value) => value === 'component-finder' ? null : 'component-finder')})
      ComponentFinderIcon
    button( type="button" className={cx('bdt-launcher-element-picker bg-white/70 backdrop-blur-3xl hover:text-active!', elementPickerActive && 'is-element-picker-active')} aria-pressed={elementPickerActive} aria-label="Element Picker" title={elementPickerTitle} onClick={() => setActiveElementTool((value) => value === 'element-picker' ? null : 'element-picker')})
      ElementPickerIcon
    button.bdt-launcher(className='backdrop-blur-3xl' type="button" title="Open Beast DevTools (Alt+Shift+D)" onClick={() => setOpen(true)})
      BeastLogo

setup
  const runtime = useSyncExternalStore(subscribeRuntime, getRuntimeSnapshot, getRuntimeSnapshot);
  const [open, setOpen] = useState(initial.open);
  const [theme, setTheme] = useState(initial.theme);
  // The dock stays mounted after closing until its slide-out ends.
  const [docked, setDocked] = useState(initial.open);
  const [tab, setTab] = useState<TabId>(initial.tab);
  const [height, setHeight] = useState(initial.height);
  const [file, setFile] = useState<string | null>(initial.file);
  const [showControlFlow, setShowControlFlow] = useState(initial.showControlFlow);
  const [componentsView, setComponentsView] = useState(initial.componentsView);
  const [settings, setSettings] = useState<AnalyzerSettings>(initial.settings);
  // Fetches run against the settled value, so typing in a settings field
  // fires one refresh instead of one per keystroke.
  const [debouncedSettings, setDebouncedSettings] = useState<AnalyzerSettings>(initial.settings);
  useEffect(() => {
    if (settings === debouncedSettings) return;
    const timer = window.setTimeout(() => setDebouncedSettings(settings), SETTINGS_DEBOUNCE_MS);
    return () => window.clearTimeout(timer);
  }, [settings]);
  const [focus, setFocus] = useState<ScrollTarget | null>(null);
  const [revision, setRevision] = useState(0);
  const [projectId, setProjectId] = useState('');
  const projectGeneration = useRef(0);
  const generation = projectGeneration.current;
  const [runtimeProject, setRuntimeProject] = useState<ProjectReport | null>(null);
  const [project, setProject] = useState<ProjectReport | null>(null);
  const [report, setReport] = useState<FileReport | null>(null);
  const [loadError, setLoadError] = useState<string | null>(null);
  const [recent, setRecent] = useState<RecentRefactor | null>(null);
  const elementInspections = useRef(new WeakMap<Element, ElementInspection>());
  const [elementInspection, setElementInspection] = useState<ElementInspection | null>(null);
  const [activeElementTool, setActiveElementTool] = useState<ElementTool | null>(null);
  const componentFinderActive = activeElementTool === 'component-finder';
  const elementPickerActive = activeElementTool === 'element-picker';
  const elementPickerTitle = elementPickerActive ? 'Stop Element Picker (Esc)' : 'Element Picker (Alt+Shift+E)';
  const componentFinderTitle = componentFinderActive ? 'Stop Component Finder (Esc)' : 'Component Finder (Alt+Shift+C)';
  const suggestionCount = project?.files.reduce((sum, entry) => sum + entry.suggestions, 0) ?? 0;
  const status = runtime.status === 'connected'
    ? `${runtime.componentCount}`
    : runtime.status === 'connecting' ? 'Connecting…' : 'Runtime off';

  useEffect(() => {
    savePreferences({ theme, open, tab, height, file, showControlFlow, componentsView, settings });
  }, [theme, open, tab, height, file, showControlFlow, componentsView, settings]);

  useEffect(() => onSourceChanged(() => setRevision((value) => value + 1)), []);

  useEffect(() => {
    const onKeyDown = (event: KeyboardEvent) => {
      if (isElementPickerShortcut(event)) {
        event.preventDefault();
        setActiveElementTool((value) => value === 'element-picker' ? null : 'element-picker');
        return;
      }
      if (isComponentFinderShortcut(event)) {
        event.preventDefault();
        setActiveElementTool((value) => value === 'component-finder' ? null : 'component-finder');
        return;
      }
      if (!isToggleShortcut(event)) return;
      event.preventDefault();
      setOpen((value) => !value);
    };
    const onResize = () => setHeight((value) => clampHeight(value));
    window.addEventListener('keydown', onKeyDown);
    window.addEventListener('resize', onResize);
    return () => {
      window.removeEventListener('keydown', onKeyDown);
      window.removeEventListener('resize', onResize);
    };
  }, []);

  useEffect(() => {
    if (open) setDocked(true);
  }, [open]);

  // `visibility` flips only once the slide-out ends, and it always transitions, even
  // when a close interrupts the slide-in before the dock has moved.
  const onDockTransitionEnd = (event: TransitionEvent) => {
    if (!open && event.target === event.currentTarget && event.propertyName === 'visibility') setDocked(false);
  };

  // Hide the dock while picking so it does not cover the page's elements.
  useEffect(() => {
    if (activeElementTool === null) return;
    setOpen(false);
    if (activeElementTool === 'element-picker') {
      return startElementPicker(
        (element) => {
          const inspection = elementInspections.current.get(element) ?? new ElementInspection(element);
          elementInspections.current.set(element, inspection);
          setElementInspection(inspection);
          setActiveElementTool(null);
          setTab('elements');
          if (element.localName !== 'rect') setOpen(true);
        },
        () => setActiveElementTool(null),
      );
    }
    return startComponentFinder(
      (source) => {
        setActiveElementTool(null);
        openInEditor(source.path, source.line, source.column);
      },
      () => setActiveElementTool(null),
    );
  }, [activeElementTool]);

  // Layout handles remain usable with the dock closed, and pause while picking.
  useEffect(() => elementInspection && activeElementTool === null
    ? startLayoutEditor(elementInspection, () => {}) : undefined, [elementInspection, activeElementTool]);

  // The project list refreshes whenever a .btsx file changes on disk.
  useEffect(() => {
    if (!open) return;
    let cancelled = false;
    Promise.all([fetchProject(debouncedSettings, projectId), fetchProject(debouncedSettings)]).then(
      ([next, running]) => {
        if (cancelled || generation !== projectGeneration.current) return;
        setRuntimeProject(running);
        setProject(next);
        setLoadError(null);
        setFile((current) => (current !== null && next.files.some((entry) => entry.path === current) ? current : (next.files[0]?.path ?? null)));
      },
      (error: Error) => {
        if (!cancelled && generation === projectGeneration.current) setLoadError(error.message);
      },
    );
    return () => {
      cancelled = true;
    };
  }, [open, revision, debouncedSettings, projectId]);

  useEffect(() => {
    if (!open || file === null) return;
    let cancelled = false;
    fetchFile(file, debouncedSettings, projectId).then(
      (next) => {
        if (cancelled || generation !== projectGeneration.current) return;
        setReport(next);
        setLoadError(null);
      },
      (error: Error) => {
        if (!cancelled && generation === projectGeneration.current) setLoadError(error.message);
      },
    );
    return () => {
      cancelled = true;
    };
  }, [open, file, revision, debouncedSettings, projectId]);

  const selectProject = (id: string) => {
    projectGeneration.current += 1;
    setProjectId(id);
    setProject(null);
    setFile(null);
    setReport(null);
    setFocus(null);
    setRecent(null);
    setLoadError(null);
    setTab('inspector');
    setRevision((value) => value + 1);
  };
  const viewSource = (path: string, line: number) => {
    if (projectId !== '') selectProject('');
    setFile(path);
    setTab('inspector');
    setFocus(scrollTarget(line));
  };
  const analyze = (path: string) => {
    if (projectId !== '') selectProject('');
    setFile(path);
    setTab('refactor');
  };

if open || docked
  section(
    ~ aria-label="Beast DevTools"
    ~ aria-hidden={open ? undefined : 'true'}
    ~ className={cx('bdt-root', 'bdt-dock', open && 'is-open')}
    ~ data-theme={theme}
    ~ style={{ height: `${height}px` }}
    ~ onTransitionEnd={onDockTransitionEnd}
    ~ )
    div.bdt-resize(
      ~ role="separator"
      ~ aria-orientation="horizontal"
      ~ aria-label="Resize Beast DevTools"
      ~ onPointerDown={(event) => startResize(event, height, setHeight)}
      ~ )
    Topbar(
      ~ theme={theme}
      ~ onToggleTheme={() => setTheme((value) => value === 'dark' ? 'light' : 'dark')}
      ~ tab={tab}
      ~ setTab={setTab}
      ~ suggestionCount={suggestionCount}
      ~ componentFinderActive={componentFinderActive}
      ~ componentFinderTitle={componentFinderTitle}
      ~ setActiveElementTool={setActiveElementTool}
      ~ elementPickerActive={elementPickerActive}
      ~ elementPickerTitle={elementPickerTitle}
      ~ project={project}
      ~ projectId={projectId}
      ~ selectProject={selectProject}
      ~ runtime={runtime}
      ~ status={status}
      ~ setOpen={setOpen}
      ~ )
    div.bdt-body(role="tabpanel" aria-label={TABS.find((item) => item.id === tab)?.label})
      switch tab
        case 'components'
          ComponentsPanel(
            ~ components={runtimeProject?.components ?? EMPTY_COMPONENTS}
            ~ entryComponents={runtimeProject?.entryComponents ?? EMPTY_STRINGS}
            ~ view={componentsView}
            ~ onViewChange={setComponentsView}
            ~ showControlFlow={showControlFlow}
            ~ onShowControlFlowChange={setShowControlFlow}
            ~ onViewSource={viewSource}
            ~ onAnalyze={analyze}
            ~ )
        case 'elements'
          ElementsPanel(inspection={elementInspection} onPick={() => setActiveElementTool('element-picker')})
        case 'inspector'
          InspectorPanel(
            ~ key={projectId}
            ~ projectId={projectId}
            ~ recent={recent}
            ~ onRecentChange={setRecent}
            ~ files={project?.files ?? EMPTY_FILES}
            ~ file={file}
            ~ report={report}
            ~ loadError={loadError}
            ~ focus={focus}
            ~ onSelectFile={setFile}
            ~ )
        default
          RefactorPanel(
            ~ key={projectId}
            ~ projectId={projectId}
            ~ files={project?.files ?? EMPTY_FILES}
            ~ file={file}
            ~ report={report}
            ~ loadError={loadError}
            ~ settings={settings}
            ~ recent={recent}
            ~ onSelectFile={setFile}
            ~ onSettingsChange={setSettings}
            ~ onRecentChange={(value) => { if (generation === projectGeneration.current) setRecent(value); }}
            ~ )
DevtoolsInterface(theme={theme} open={open} componentFinderActive={componentFinderActive} componentFinderTitle={componentFinderTitle} setActiveElementTool={setActiveElementTool} elementPickerActive={elementPickerActive} elementPickerTitle={elementPickerTitle} setOpen={setOpen})
