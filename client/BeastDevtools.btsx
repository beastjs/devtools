import { useEffect, useState, useSyncExternalStore } from 'octane'
import type { AnalyzerSettings, FileReport, ProjectReport } from '../shared/types.ts'
import ComponentsPanel from './ComponentsPanel.btsx'
import InspectorPanel from './InspectorPanel.btsx'
import RefactorPanel from './RefactorPanel.btsx'
import { fetchFile, fetchProject, onSourceChanged, openInEditor } from './api.ts'
import { startPicker, type PickerMode } from './picker.ts'
import { getRuntimeSnapshot, subscribeRuntime } from './runtime.ts'
import { clampHeight, cx, loadPreferences, savePreferences, scrollTarget, startResize, type RecentRefactor, type ScrollTarget, type TabId } from './util.ts'

module
  const TABS: ReadonlyArray<{ id: TabId; label: string }> = [
    { id: 'components', label: 'Components' },
    { id: 'inspector', label: 'BTSX → TSRX' },
    { id: 'refactor', label: 'Refactor' },
  ]
  const LOGO_PATH = 'm12.01.001c.002.002.152.006.333.01 1.672.036 3.366.451 4.905 1.204a12.06 12.06 0 0 1 6.141 7.002c.375 1.124.581 2.305.608 3.48a11.9 11.9 0 0 1-1.027 5.183c-.108.245-.355.736-.5.993a12.1 12.1 0 0 1-3.417 3.843c-.203.15-.666.456-.886.588a11.95 11.95 0 0 1-5.648 1.7c-.114.008-.978.008-1.028.001a12 12 0 0 1-1.675-.189 12.03 12.03 0 0 1-7.211-4.336 12.3 12.3 0 0 1-1.582-2.6c-.58-1.314-.89-2.565-1.008-4.065-.02-.255-.02-1.343 0-1.613.122-1.632.512-3.076 1.212-4.49a12 12 0 0 1 1.828-2.708c.19-.214.726-.75.936-.937A12 12 0 0 1 8.228.608a12 12 0 0 1 3.036-.585 10 10 0 0 1 .369-.011 10 10 0 0 0 .377-.011m1.768 4.219a9 9 0 0 0-1.31-.186c-.22-.011-.852-.006-1.056.01a8 8 0 0 0-2.938.79l-.077.039 1.8 1.8 1.8 1.799 1.799-1.8 1.8-1.8-.077-.038a8 8 0 0 0-1.74-.614m6.208 7.351a8 8 0 0 0-.777-3.006l-.075-.157-1.8 1.8-1.8 1.8 1.799 1.8 1.8 1.8.038-.077a7.9 7.9 0 0 0 .802-2.92c.021-.252.028-.81.013-1.04M8.46 12.01l-1.8-1.8-1.799-1.8-.048.097a8.1 8.1 0 0 0-.806 3.078c-.03.564.01 1.21.11 1.793.127.73.389 1.53.705 2.154l.04.077 1.799-1.8zm7.138 7.137L13.8 17.35c-.99-.989-1.8-1.798-1.804-1.798-.003 0-.814.81-1.803 1.798l-1.797 1.797.156.075c.835.4 1.727.645 2.706.742a12 12 0 0 0 1.235.017 8 8 0 0 0 2.947-.759z'

  const initial = loadPreferences()

  /** Alt+Shift+D toggles the panel. `code` is used because Alt changes `key` on macOS. */
  function isToggleShortcut(event: KeyboardEvent): boolean {
    return event.altKey && event.shiftKey && !event.metaKey && !event.ctrlKey && event.code === 'KeyD'
  }

  /** Alt+Shift+C toggles the element picker. */
  function isPickShortcut(event: KeyboardEvent): boolean {
    return event.altKey && event.shiftKey && !event.metaKey && !event.ctrlKey && event.code === 'KeyC'
  }

component BeastLogo
  svg.bdt-logo(viewBox="0 0 24 24" fill="none" aria-hidden="true")
    path(fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d={LOGO_PATH})

component PickIcon
  svg(viewBox="0 0 16 16" fill="none" aria-hidden="true")
    path(d="M2.5 6V3.5a1 1 0 0 1 1-1H6M10 2.5h2.5a1 1 0 0 1 1 1V6M13.5 10v2.5a1 1 0 0 1-1 1H10M6 13.5H3.5a1 1 0 0 1-1-1V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round")
    circle(cx="8" cy="8" r="1.75" fill="currentColor")

component PropertiesIcon
  svg(viewBox="0 0 16 16" fill="none" aria-hidden="true")
    rect(x="2" y="2" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5")
    path(d="M5 2v3M8 2v2M11 2v3M2 5h3M2 8h2M2 11h3" stroke="currentColor" stroke-width="1.5")

setup
  const runtime = useSyncExternalStore(subscribeRuntime, getRuntimeSnapshot, getRuntimeSnapshot);
  const [open, setOpen] = useState(initial.open);
  // The dock stays mounted after closing until its slide-out ends.
  const [docked, setDocked] = useState(initial.open);
  const [tab, setTab] = useState<TabId>(initial.tab);
  const [height, setHeight] = useState(initial.height);
  const [file, setFile] = useState<string | null>(initial.file);
  const [showControlFlow, setShowControlFlow] = useState(initial.showControlFlow);
  const [componentsView, setComponentsView] = useState(initial.componentsView);
  const [settings, setSettings] = useState<AnalyzerSettings>(initial.settings);
  const [focus, setFocus] = useState<ScrollTarget | null>(null);
  const [revision, setRevision] = useState(0);
  const [project, setProject] = useState<ProjectReport | null>(null);
  const [report, setReport] = useState<FileReport | null>(null);
  const [loadError, setLoadError] = useState<string | null>(null);
  const [recent, setRecent] = useState<RecentRefactor | null>(null);
  const [pickerMode, setPickerMode] = useState<PickerMode | null>(null);
  const picking = pickerMode === 'source';
  const inspecting = pickerMode === 'properties';
  const inspectTitle = inspecting ? 'Stop inspecting properties (Esc)' : 'Inspect element properties (Alt+Shift+E)';
  const pickTitle = picking ? 'Stop picking (Esc)' : 'Pick an element to open its source (Alt+Shift+C)';
  const suggestionCount = project?.files.reduce((sum, entry) => sum + entry.suggestions, 0) ?? 0;
  const status = runtime.status === 'connected'
    ? `${runtime.componentCount} component${runtime.componentCount === 1 ? '' : 's'} live`
    : runtime.status === 'connecting' ? 'Connecting…' : 'Runtime off';

  useEffect(() => {
    savePreferences({ open, tab, height, file, showControlFlow, componentsView, settings });
  }, [open, tab, height, file, showControlFlow, componentsView, settings]);

  useEffect(() => onSourceChanged(() => setRevision((value) => value + 1)), []);

  useEffect(() => {
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.altKey && event.shiftKey && !event.metaKey && !event.ctrlKey && event.code === 'KeyE') {
        event.preventDefault();
        setPickerMode((value) => value === 'properties' ? null : 'properties');
        return;
      }
      if (isPickShortcut(event)) {
        event.preventDefault();
        setPickerMode((value) => value === 'source' ? null : 'source');
        return;
      }
      if (!isToggleShortcut(event)) return;
      event.preventDefault();
      setOpen((value) => !value);
    };
    const onResize = () => setHeight((value) => clampHeight(value));
    window.addEventListener('keydown', onKeyDown);
    window.addEventListener('resize', onResize);
    return () => {
      window.removeEventListener('keydown', onKeyDown);
      window.removeEventListener('resize', onResize);
    };
  }, []);

  useEffect(() => {
    if (open) setDocked(true);
  }, [open]);

  // `visibility` flips only once the slide-out ends, and it always transitions, even
  // when a close interrupts the slide-in before the dock has moved.
  const onDockTransitionEnd = (event: TransitionEvent) => {
    if (!open && event.target === event.currentTarget && event.propertyName === 'visibility') setDocked(false);
  };

  // Source mode ends on a pick; properties mode stays active until toggled or Escape.
  useEffect(() => {
    if (pickerMode === null) return;
    return startPicker(
      (source) => {
        setPickerMode(null);
        openInEditor(source.path, source.line, source.column);
      },
      () => setPickerMode(null),
      pickerMode,
    );
  }, [pickerMode]);

  // The project list refreshes whenever a .btsx file changes on disk.
  useEffect(() => {
    if (!open) return;
    let cancelled = false;
    fetchProject(settings).then(
      (next) => {
        if (cancelled) return;
        setProject(next);
        setLoadError(null);
        setFile((current) => (current !== null && next.files.some((entry) => entry.path === current) ? current : (next.files[0]?.path ?? null)));
      },
      (error: Error) => {
        if (!cancelled) setLoadError(error.message);
      },
    );
    return () => {
      cancelled = true;
    };
  }, [open, revision, settings]);

  useEffect(() => {
    if (!open || file === null) return;
    let cancelled = false;
    fetchFile(file, settings).then(
      (next) => {
        if (cancelled) return;
        setReport(next);
        setLoadError(null);
      },
      (error: Error) => {
        if (!cancelled) setLoadError(error.message);
      },
    );
    return () => {
      cancelled = true;
    };
  }, [open, file, revision, settings]);

  const viewSource = (path: string, line: number) => {
    setFile(path);
    setTab('inspector');
    setFocus(scrollTarget(line));
  };
  const analyze = (path: string) => {
    setFile(path);
    setTab('refactor');
  };

if open || docked
  section(
    ~ aria-label="Beast DevTools"
    ~ aria-hidden={open ? undefined : 'true'}
    ~ className={cx('bdt-root', 'bdt-dock', open && 'is-open')}
    ~ style={{ height: `${height}px` }}
    ~ onTransitionEnd={onDockTransitionEnd}
    ~ )
    div.bdt-resize(
      ~ role="separator"
      ~ aria-orientation="horizontal"
      ~ aria-label="Resize Beast DevTools"
      ~ onPointerDown={(event) => startResize(event, height, setHeight)}
      ~ )
    header.bdt-topbar
      .bdt-brand
        BeastLogo
        div(className="skew-4") Beast
        span.bdt-brand-sub DevTools
      nav.bdt-tabs(role="tablist" aria-label="Beast DevTools panels" className="has[:focus]:rounded-sm! rounded-full")
        each item in TABS key item.id
          button(
            ~ type="button"
            ~ role="tab"
            ~ aria-selected={tab === item.id}
            ~ className={cx('bdt-tab', tab === item.id && 'is-active')}
            ~ onClick={() => setTab(item.id)}
            ~ )
            | #{item.label}
            if item.id === 'refactor' && suggestionCount > 0
              span.bdt-tab-count(title={`${suggestionCount} refactor suggestion${suggestionCount === 1 ? '' : 's'}`}) #{suggestionCount}
      .bdt-spacer
      button(type="button" className={cx('bdt-icon-button', picking && 'is-picking')} aria-pressed={picking} aria-label="Pick an element" title={pickTitle} onClick={() => setPickerMode((value) => value === 'source' ? null : 'source')})
        PickIcon
      button(type="button" className={cx('bdt-icon-button', inspecting && 'is-picking')} aria-pressed={inspecting} aria-label="Inspect element properties" title={inspectTitle} onClick={() => setPickerMode((value) => value === 'properties' ? null : 'properties')})
        PropertiesIcon
      span.bdt-status
        span(className={cx('bdt-launcher-dot', runtime.status === 'connected' && 'is-live')})
        | #{status}
      button.bdt-icon-button(type="button" aria-label="Close Beast DevTools" title="Close (Alt+Shift+D)" onClick={() => setOpen(false)})
        svg(viewBox="0 0 16 16" fill="none" aria-hidden="true")
          path(d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round")
    div.bdt-body(role="tabpanel" aria-label={TABS.find((item) => item.id === tab)?.label})
      switch tab
        case 'components'
          ComponentsPanel(
            ~ components={project?.components ?? []}
            ~ entryComponents={project?.entryComponents ?? []}
            ~ view={componentsView}
            ~ onViewChange={setComponentsView}
            ~ showControlFlow={showControlFlow}
            ~ onShowControlFlowChange={setShowControlFlow}
            ~ onViewSource={viewSource}
            ~ onAnalyze={analyze}
            ~ )
        case 'inspector'
          InspectorPanel(
            ~ files={project?.files ?? []}
            ~ file={file}
            ~ report={report}
            ~ loadError={loadError}
            ~ focus={focus}
            ~ onSelectFile={setFile}
            ~ )
        default
          RefactorPanel(
            ~ files={project?.files ?? []}
            ~ file={file}
            ~ report={report}
            ~ loadError={loadError}
            ~ settings={settings}
            ~ recent={recent}
            ~ onSelectFile={setFile}
            ~ onSettingsChange={setSettings}
            ~ onRecentChange={setRecent}
            ~ )
div(className={cx('bdt-root', 'bdt-launcher-host', open && 'is-hidden')} aria-hidden={open ? 'true' : undefined})
  button(type="button" className={cx('bdt-launcher-pick bg-white/50 backdrop-blur-3xl', picking && 'is-picking')} aria-pressed={picking} aria-label="Pick an element" title={pickTitle} onClick={() => setPickerMode((value) => value === 'source' ? null : 'source')})
    PickIcon
  button( type="button" className={cx('bdt-launcher-pick bg-white/70 backdrop-blur-3xl hover:text-active!', inspecting && 'is-prop-picking')} aria-pressed={inspecting} aria-label="Inspect element properties" title={inspectTitle} onClick={() => setPickerMode((value) => value === 'properties' ? null : 'properties')})
    PropertiesIcon
  button.bdt-launcher(className=' backdrop-blur-3xl' type="button" title="Open Beast DevTools (Alt+Shift+D)" onClick={() => setOpen(true)})
    BeastLogo
    // span
    // span(className={cx('bdt-launcher-dot', runtime.status === 'connected' && 'is-live')} aria-label={status})
