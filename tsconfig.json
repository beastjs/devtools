{
  // Editor and `bun run typecheck` settings. Publishing uses tsconfig.build.json,
  // which compiles only the Node-side plugin.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["vite.ts", "server", "shared", "client"],
  "exclude": ["**/*.test.ts"]
}
