import { createContext, useContext, useId, useLayoutEffect, useRef, useState } from "octane";
import type { ComponentProps } from "octane";
import { cn } from "cn";
import {Icon} from "../../../packages/icons/src/";

module
  export type MessageScrollerScrollOptions = { behavior?: ScrollBehavior; align?: "start" | "center" | "end" | "nearest"; scrollMargin?: number };
  export type MessageScrollerScrollable = { start: boolean; end: boolean };
  export type MessageScrollerVisibilityState = { currentAnchorId: string | null; visibleMessageIds: string[] };
  interface ScrollerContext {
    viewport: { current: HTMLDivElement | null };
    pinned: { current: boolean };
    autoScroll: boolean;
    defaultScrollPosition: "start" | "end" | "last-anchor";
    scrollEdgeThreshold: number;
    scrollMargin: number;
    scrollable: MessageScrollerScrollable;
    visibility: MessageScrollerVisibilityState;
    update: () => void;
    scrollToStart: (options?: MessageScrollerScrollOptions) => boolean;
    scrollToEnd: (options?: MessageScrollerScrollOptions) => boolean;
    scrollToMessage: (id: string, options?: MessageScrollerScrollOptions) => boolean;
  }
  function setViewportRef(ref: ComponentProps<"div">["ref"], node: HTMLDivElement | null): void {
    if (!ref) return;
    if (typeof ref === "function") ref(node);
    else if ("current" in ref) ref.current = node;
    else for (const item of ref) setViewportRef(item, node);
  }
  const ScrollerContext = createContext<ScrollerContext | null>(null);
  function useScrollerContext() {
    const context = useContext(ScrollerContext);
    if (!context) throw new Error("MessageScroller components need a MessageScrollerProvider.");
    return context;
  }
  export function useMessageScroller() {
    const { scrollToStart, scrollToEnd, scrollToMessage } = useScrollerContext();
    return { scrollToStart, scrollToEnd, scrollToMessage };
  }
  export function useMessageScrollerScrollable() { return useScrollerContext().scrollable; }
  export function useMessageScrollerVisibility() { return useScrollerContext().visibility; }
  export { MessageScrollerProvider, MessageScrollerViewport, MessageScrollerContent, MessageScrollerItem, MessageScrollerButton };
component MessageScrollerProvider
  props { children, autoScroll = true, defaultScrollPosition = "end", scrollEdgeThreshold = 8, scrollMargin = 0 }: {
    ~ children?: unknown;
    ~ autoScroll?: boolean;
    ~ defaultScrollPosition?: "start" | "end" | "last-anchor";
    ~ scrollEdgeThreshold?: number;
    ~ scrollMargin?: number;
    ~ }
  setup
    const viewport = useRef<HTMLDivElement | null>(null);
    const pinned = useRef(defaultScrollPosition !== "start");
    const [scrollable, setScrollable] = useState<MessageScrollerScrollable>({ start: false, end: false });
    const [visibility, setVisibility] = useState<MessageScrollerVisibilityState>({ currentAnchorId: null, visibleMessageIds: [] });
    const update = () => {
      const node = viewport.current;
      if (!node) return;
      const start = node.scrollTop > scrollEdgeThreshold;
      const end = node.scrollHeight - node.clientHeight - node.scrollTop > scrollEdgeThreshold;
      pinned.current = !end;
      setScrollable(previous => previous.start === start && previous.end === end ? previous : { start, end });
      const frame = node.getBoundingClientRect();
      const visible = Array.from(node.querySelectorAll<HTMLElement>("[data-message-id]")).filter(item => {
        const bounds = item.getBoundingClientRect();
        return bounds.bottom > frame.top && bounds.top < frame.bottom;
      });
      const next = { currentAnchorId: visible.find(item => item.hasAttribute("data-scroll-anchor"))?.dataset.messageId ?? null, visibleMessageIds: visible.map(item => item.dataset.messageId!) };
      setVisibility(previous => previous.currentAnchorId === next.currentAnchorId && previous.visibleMessageIds.join("\0") === next.visibleMessageIds.join("\0") ? previous : next);
    };
    const scroll = (top: number, options: MessageScrollerScrollOptions = {}) => {
      const node = viewport.current;
      if (!node) return false;
      const behavior = typeof matchMedia === "function" && matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : options.behavior ?? "smooth";
      node.scrollTo({ top, behavior });
      return true;
    };
    const scrollToStart = (options?: MessageScrollerScrollOptions) => scroll(0, options);
    const scrollToEnd = (options?: MessageScrollerScrollOptions) => scroll(viewport.current?.scrollHeight ?? 0, options);
    const scrollToMessage = (id: string, options: MessageScrollerScrollOptions = {}) => {
      const node = viewport.current;
      const item = node && Array.from(node.querySelectorAll<HTMLElement>("[data-message-id]")).find(item => item.dataset.messageId === id);
      if (!node || !item) return false;
      const bounds = item.getBoundingClientRect();
      const frame = node.getBoundingClientRect();
      const margin = options.scrollMargin ?? scrollMargin;
      const align = options.align ?? "start";
      if (align === "nearest" && bounds.top >= frame.top && bounds.bottom <= frame.bottom) return true;
      const offset = align === "end" ? bounds.bottom - frame.bottom + margin : align === "center" ? bounds.top - frame.top - (node.clientHeight - bounds.height) / 2 : bounds.top - frame.top - margin;
      return scroll(node.scrollTop + offset, options);
    };
    const value: ScrollerContext = { viewport, pinned, autoScroll, defaultScrollPosition, scrollEdgeThreshold, scrollMargin, scrollable, visibility, update, scrollToStart, scrollToEnd, scrollToMessage };
  ScrollerContext(value={value}) #{children}
component MessageScrollerViewport
  props { className, children, onScroll, ref, preserveScrollOnPrepend = true, ...props }: ComponentProps<"div"> & { preserveScrollOnPrepend?: boolean }
  setup
    const context = useScrollerContext();
    // Observer callbacks read current options without reconnecting on every scroll.
    const current = useRef(context);
    current.current = context;
    useLayoutEffect(() => {
      const node = current.current.viewport.current;
      if (!node) return;
      let previousHeight = node.scrollHeight;
      let previousFirst = node.querySelector<HTMLElement>("[data-message-id]")?.dataset.messageId;
      const changed = () => {
        const value = current.current;
        const first = node.querySelector<HTMLElement>("[data-message-id]")?.dataset.messageId;
        if (preserveScrollOnPrepend && previousFirst && first !== previousFirst && Array.from(node.querySelectorAll<HTMLElement>("[data-message-id]")).some(item => item.dataset.messageId === previousFirst)) {
          node.scrollTop += node.scrollHeight - previousHeight;
        } else if (value.autoScroll && value.pinned.current) {
          node.scrollTop = node.scrollHeight;
        }
        previousHeight = node.scrollHeight;
        previousFirst = first;
        value.update();
      };
      if (current.current.defaultScrollPosition === "last-anchor") {
        const anchor = Array.from(node.querySelectorAll<HTMLElement>("[data-scroll-anchor]")).at(-1);
        if (anchor?.dataset.messageId) current.current.scrollToMessage(anchor.dataset.messageId, { behavior: "instant" });
        else node.scrollTop = node.scrollHeight;
      } else if (current.current.defaultScrollPosition === "end") node.scrollTop = node.scrollHeight;
      current.current.update();
      const resize = typeof ResizeObserver === "undefined" ? undefined : new ResizeObserver(changed);
      resize?.observe(node);
      if (node.firstElementChild) resize?.observe(node.firstElementChild);
      const mutation = new MutationObserver(changed);
      mutation.observe(node, { childList: true, subtree: true, characterData: true });
      return () => { resize?.disconnect(); mutation.disconnect(); };
    }, [preserveScrollOnPrepend]);
  div(
    ~ data-slot="message-scroller-viewport"
    ~ ref={(node) => { context.viewport.current = node; setViewportRef(ref, node); }}
    ~ role="region"
    ~ aria-label="Messages"
    ~ tabIndex={0}
    ~ className={cn("cn-message-scroller-viewport size-full min-h-0 min-w-0 overflow-y-auto overscroll-contain outline-none focus-visible:ring-2 focus-visible:ring-ring", className)}
    ~ {...props}
    ~ onScroll={(event) => { context.update(); onScroll?.(event); }}
    ~ ) #{children}
component MessageScrollerContent
  props { className, ...props }: ComponentProps<"div">
  div(data-slot="message-scroller-content" role="log" aria-live="polite" aria-relevant="additions text" className={cn("cn-message-scroller-content flex min-h-full flex-col", className)} {...props})
component MessageScrollerItem
  props { className, messageId, scrollAnchor = false, ...props }: ComponentProps<"div"> & { messageId?: string; scrollAnchor?: boolean }
  setup
    const autoId = useId();
  div(data-slot="message-scroller-item" data-message-id={messageId ?? autoId} data-scroll-anchor={scrollAnchor ? "" : undefined} className={cn("cn-message-scroller-item min-w-0 shrink-0", className)} {...props})
component MessageScrollerButton
  props { direction = "end", behavior = "smooth", className, children, onClick, ...props }: ComponentProps<"button"> & { direction?: "start" | "end"; behavior?: ScrollBehavior }
  setup
    const context = useScrollerContext();
    const active = context.scrollable[direction];
  button(
    ~ data-slot="message-scroller-button"
    ~ data-direction={direction}
    ~ data-active={active}
    ~ type="button"
    ~ className={cn("cn-message-scroller-button absolute left-1/2 flex size-7 -translate-x-1/2 items-center justify-center rounded-full bg-[var(--bdt-bg-5)] shadow-md transition-opacity data-[direction=end]:bottom-4 data-[direction=start]:top-4 data-[active=false]:pointer-events-none data-[active=false]:opacity-0", className)}
    ~ aria-label={direction === "end" ? "Scroll to end" : "Scroll to start"}
    ~ tabIndex={active ? 0 : -1}
    ~ aria-hidden={!active}
    ~ {...props}
    ~ onClick={(event) => { onClick?.(event); if (!event.defaultPrevented) (direction === "end" ? context.scrollToEnd : context.scrollToStart)({ behavior }); }}
    ~ )
    if children
      | #{children}
    else
      Icon(name="arrow-down" size={12} className='size-4 text-[var(--bdt-dim-2)]')
      // svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true" className={direction === "start" ? "rotate-180" : undefined})
      //   path(d="M12 4v16m-6-6 6 6 6-6")

props { className, ...props }: ComponentProps<"div">
div(data-slot="message-scroller" className={cn("cn-message-scroller relative flex size-full min-h-0 flex-col overflow-hidden", className)} {...props})
